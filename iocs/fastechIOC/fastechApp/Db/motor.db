record(motor,"$(SYS):$(SUB)")
{
    field(DESC,"$(DESC)")
    field(DTYP,"asynMotor")
    field(DIR,"$(DIR=Pos)")
    field(VELO,"$(VELO)")
    field(VBAS,"$(VBAS)")
    field(ACCL,"$(ACCL)")
    field(OUT,"@asyn($(CONT),$(AXIS))")
    field(MRES,"$(MRES)")
    field(EGU,"$(EGU=mm)")
    field(TWV,"$(TWV)")
}
