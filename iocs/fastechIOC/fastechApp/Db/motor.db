record(motor,"$(SYS):$(SUB)")
{
    field(DESC,"$(DESC)")
    field(DTYP,"asynMotor")
    field(DIR,"$(DIR=Pos)")
    field(VELO,"$(VELO=10)")
    field(VBAS,"$(VBAS=0.1)")
    field(ACCL,"$(ACCL=0.1)")
    field(OUT,"@asyn($(CONT),$(AXIS))")
    field(MRES,"$(MRES)")
    field(EGU,"$(EGU=mm)")
    field(TWV,"$(TWV)")
}
